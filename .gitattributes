# Normalize line endings to LF in the repo; Git converts to CRLF on checkout
# for text files on Windows. Stops the "LF will be replaced by CRLF" churn.
* text=auto eol=lf

# Windows batch scripts keep CRLF
*.bat eol=crlf

# Binary assets — never normalize
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.icns binary
*.keystore binary
*.jks binary
